{
  "description": "Babysit every agent-opened pull request (ADR-0004). Opt out with IPE_BABYSIT_PR_HOOK=off.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__.*__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/babysit-pr.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
